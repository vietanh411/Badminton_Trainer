# Copy to .env and adjust. Every setting is optional; defaults are shown.

# Where uploads, analysis artifacts, cache and the SQLite database live (default: ./data).
# BV_DATA_DIR=./data
# Model weights directory (default: ./models/weights, filled by scripts/download_models.py).
# BV_MODELS_DIR=./models/weights
# SQLAlchemy URL. Default: SQLite in BV_DATA_DIR. PostgreSQL example:
# BV_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/badmintonvision

# Upload limits.
# BV_MAX_UPLOAD_MB=1024
# BV_MAX_DURATION_S=1800

# Analysis concurrency: jobs running at once / jobs allowed in the queue.
# BV_MAX_CONCURRENT_JOBS=1
# BV_MAX_QUEUED_JOBS=4

# Require this key (header X-API-Key) on every /api call except /api/health.
# Set it whenever the server is reachable by anyone other than you.
# BV_API_KEY=

# Allowed browser origins for the API (JSON list).
# BV_CORS_ORIGINS=["http://localhost:5173"]

# Disable the synthetic demo endpoint in deployments.
# BV_ENABLE_DEMO=true

# BV_LOG_LEVEL=INFO

# Frontend (Vite) — read at build time from frontend/.env or the environment.
# VITE_API_BASE=            # empty = same origin (/api is proxied in dev and by nginx in Docker)
# VITE_API_KEY=             # only for personal deployments; anyone with the built JS can read it
